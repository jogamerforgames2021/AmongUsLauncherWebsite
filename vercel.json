{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/201.html" },
    { "source": "/index", "destination": "/201.html" },
    { "source": "/aa", "destination": "/201.html" },
    { "source": "/amongus", "destination": "/201.html" },
    { "source": "/developer", "destination": "/201.html" },
    { "source": "/helpPage", "destination": "/201.html" },
    { "source": "/home", "destination": "/201.html" },
    { "source": "/news", "destination": "/201.html" },
    { "source": "/news/:path*", "destination": "/201.html" },
    { "source": "/post", "destination": "/201.html" },
    { "source": "/post/:path*", "destination": "/201.html" },
    { "source": "/privacy", "destination": "/201.html" },
    { "source": "/terms", "destination": "/201.html" },
    { "source": "/users", "destination": "/201.html" },
    { "source": "/users/:path*", "destination": "/201.html" },
    { "source": "/tools", "destination": "/201.html" },
    { "source": "/tools/:path*", "destination": "/201.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
