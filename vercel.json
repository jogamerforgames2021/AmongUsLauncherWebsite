{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/post/:slug", "destination": "/post" },
    { "source": "/users/:id", "destination": "/users" },
    { "source": "/lobby/:code/copy", "destination": "/lobby-copy?code=:code" },
    { "source": "/lobby/:code", "destination": "/lobby" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
